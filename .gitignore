# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
testsprite_tests/

# next.js
/.next/
/out/

# production
/build

# misc & OS
.DS_Store
Thumbs.db
*.pem
*.rar
*.zip

# logs & temporary files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lint_output.txt
lint_results.txt
search_results.txt

# scratch & local tools
scratch/
.agent/
check-users.ts
create-test-user.ts

# IDE / Editor
.vscode/
.idea/

# env files (strict: ignore all .env files except .env.example)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
